# Base de datos (PostgreSQL 17 + PostGIS 3.5). En docker compose dev: localhost:5432
DATABASE_URL=postgres://postgres:password@localhost:5432/sigdom

# Better Auth. Generar el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Público (expuesto al navegador)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Archivos (adjuntos e importaciones). En Docker: /data/storage (volumen)
STORAGE_DIR=./storage
MAX_IMPORT_FILE_MB=10
MAX_ATTACHMENT_MB=20

# Geocodificación. Proveedores en orden; padron es local y siempre va primero.
GEOCODER_PROVIDERS=padron,nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=
# Obligatorio si se usa nominatim/photon público (política de uso de OSM)
GEOCODER_CONTACT_EMAIL=

LOG_LEVEL=info
