{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,route,error,not-found,loading,template,default}.{ts,tsx}",
    "scripts/*.ts",
    "scripts/*.mjs",
    "e2e/**/*.ts",
    "content/help/**/*.mdx"
  ],
  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "scripts/**/*.ts", "scripts/**/*.mjs", "e2e/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": ["tw-animate-css", "pino-pretty"]
}
