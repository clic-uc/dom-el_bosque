{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,route,error,not-found,loading,template,default}.{ts,tsx}",
    "proxy.ts",
    "scripts/*.ts",
    "src/db/schema/index.ts",
    "drizzle.config.ts",
    "next.config.ts",
    "vitest.config.mts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "content/help/**/*.mdx"
  ],
  "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "scripts/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": ["@mdx-js/loader", "@mdx-js/react", "tw-animate-css", "pino-pretty", "esbuild", "@types/mdx"],
  "ignoreBinaries": ["docker"]
}
