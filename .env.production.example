# Producción: copiar a .env.production y completar. NUNCA versionar .env.production.
#   cp .env.production.example .env.production
# Lo leen los servicios app y worker (env_file). `docker compose --env-file .env.production` interpola
# POSTGRES_*, NEXT_PUBLIC_* y SITE_ADDRESS en docker-compose.prod.yml; db recibe solo POSTGRES_*.

# --- Base de datos (servicio `db` de docker-compose.prod.yml; sin puerto expuesto) ---
POSTGRES_DB=sigdom
POSTGRES_USER=postgres
# Contraseña propia y larga: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
# Debe coincidir con los valores anteriores. Host `db` = nombre del servicio en compose.
DATABASE_URL=postgres://postgres:CAMBIA_ESTA_CONTRASENA@db:5432/sigdom

# --- Better Auth ---
# Secreto propio de esta instalación: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://sigdomelbosque.cl

# --- Público (se inserta en el bundle del navegador al construir la imagen) ---
NEXT_PUBLIC_APP_URL=https://sigdomelbosque.cl
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Producción con Docker siempre es `full` (todas las capacidades). `staging` es solo para Vercel + Neon.
NEXT_PUBLIC_DEPLOY_MODE=full

# --- Caddy: dominio con TLS automático (DNS A/AAAA apuntando al VPS). `localhost` para pruebas. ---
SITE_ADDRESS=sigdomelbosque.cl

# --- Archivos (adjuntos e importaciones): volumen app_storage montado en /data/storage ---
STORAGE_DIR=/data/storage
MAX_IMPORT_FILE_MB=10
MAX_ATTACHMENT_MB=20

# --- Geocodificación (§8.7). El padrón local siempre va primero. ---
GEOCODER_PROVIDERS=padron,nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=
# OBLIGATORIO con nominatim/photon públicos: correo de contacto exigido por la política de uso de OSM.
GEOCODER_CONTACT_EMAIL=dom@imelbosque.cl

# --- Logs (JSON en producción) ---
LOG_LEVEL=info
NODE_ENV=production
