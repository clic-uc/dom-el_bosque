# Staging en Vercel + Neon (capa gratuita). Ver docs/DEPLOY.md, sección "Staging".
# Copiar a .env.staging y completar. NUNCA versionar .env.staging.
#   cp .env.staging.example .env.staging
#
# Este archivo sirve para dos cosas:
#   1. Referencia de las variables a cargar en el proyecto de Vercel (Settings → Environment Variables).
#      En Vercel NO se carga DATABASE_URL_DIRECT: la app usa solo la conexión pooled.
#   2. Correr los scripts desde tu equipo contra Neon:
#        ENV_FILE=.env.staging pnpm db:migrate
#        ENV_FILE=.env.staging pnpm db:seed
#        ENV_FILE=.env.staging pnpm geo:import
#        ENV_FILE=.env.staging pnpm auth:create-admin
#      (solo si DATABASE_URL no está ya definida en la terminal; los scripts prefieren DATABASE_URL_DIRECT)

# --- Modo de despliegue: alcance reducido (sin archivos adjuntos, importaciones pequeñas, sin worker) ---
# Se fija en el build: si se cambia en Vercel hay que volver a desplegar.
NEXT_PUBLIC_DEPLOY_MODE=staging

# --- Base de datos (Neon → Connection Details) ---
# Pooled (host con "-pooler"): la usa la app en Vercel.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (mismo host sin "-pooler"): solo para migraciones y scripts desde tu equipo. No cargar en Vercel.
DATABASE_URL_DIRECT=postgresql://USUARIO:CONTRASENA@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# --- Better Auth ---
# Secreto propio de staging, DISTINTO al de producción: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública del proyecto en Vercel (la de producción del proyecto de staging, sin "/" final).
BETTER_AUTH_URL=https://sigdom-staging.vercel.app

# --- Público (se inserta en el bundle al construir) ---
NEXT_PUBLIC_APP_URL=https://sigdom-staging.vercel.app
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Geocodificación: solo el padrón local (sin OpenStreetMap en staging) ---
GEOCODER_PROVIDERS=padron

# --- Logs ---
LOG_LEVEL=info

# No se usan en staging (no hay disco persistente; los topes de importación los fija el modo staging):
# STORAGE_DIR, MAX_IMPORT_FILE_MB, MAX_ATTACHMENT_MB, NOMINATIM_URL, PHOTON_URL, GEOCODER_CONTACT_EMAIL
